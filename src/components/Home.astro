---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url)).home;
---

<Layout title="Enzo Hillairet">
	<Header />
	<main class="px-5 md:px-20 py-10">
		<h1 class="font-display font-black uppercase text-5xl">Enzo Hillairet</h1>
		<p class="text-muted mt-4">{t.placeholder}</p>
		<div class="bg-surface mt-6 p-6">Surface</div>
	</main>
</Layout>
